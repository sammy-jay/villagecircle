# ── Core ──
DATABASE_URL="mongodb+srv://USER:PASS@CLUSTER.mongodb.net/village-circle?retryWrites=true&w=majority"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""            # openssl rand -base64 32
APP_URL="http://localhost:3000"
FIELD_ENCRYPTION_KEY=""       # 32-byte hex (openssl rand -hex 32) — encrypts TOTP secrets
CRON_SECRET=""                # shared secret for /api/cron/* (Vercel Cron sends it as Bearer)
APP_TIMEZONE="Africa/Lagos"   # the platform time zone for times shown and typed (default America/Chicago if unset)

# ── Google sign-in ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email: Resend ──
RESEND_API_KEY=""
EMAIL_FROM="The Village Circle <hello@yourdomain.org>"

# ── SMS / verification: Twilio ──
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_FROM_NUMBER=""

# ── Video: Daily ──
DAILY_API_KEY=""
DAILY_DOMAIN=""
DAILY_WEBHOOK_SECRET=""        # from the Daily dashboard (webhooks); signs recording-ready events

# ── File storage: S3-compatible (AWS S3, R2, Backblaze) ──
S3_ENDPOINT=""                # leave empty for AWS
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
RECORDINGS_BASE_URL=""        # where guardians and the safeguarding lead play back call recordings (G3)

# ── Calendar (optional two-way sync; ICS invites work without these) ──
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# ── Background screening (provider TBC; adapter defaults to Checkr) ──
SCREENING_PROVIDER="checkr"
CHECKR_API_KEY=""
CHECKR_WEBHOOK_SECRET=""

# ── Analytics: PostHog ──
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_API_KEY=""

# ── First admin (used by `npm run db:seed`) ──
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""        # 10+ characters; you set up the authenticator app on first sign-in
SEED_ADMIN_NAME="Admin"

# ── Maintenance ──
MAINTENANCE_MODE=""            # 1 takes the site offline (pages show /maintenance; health, cron and webhooks keep working)
MAINTENANCE_WINDOW=""          # shown on /maintenance, e.g. "Saturday 17 October, 2:00 to 4:00 am"
MAINTENANCE_BACK_BY=""
MAINTENANCE_LENGTH=""
MAINTENANCE_NOTICE=""          # a sentence shown on every page ahead of a window, e.g. "Planned maintenance on Sunday 25 October from 2:00 am."
